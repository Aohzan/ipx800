{
  "entity": {
    "climate": {
      "ipx800v4_climate": {
        "state_attributes": {
          "preset_mode": {
            "state": {
              "none": "mdi:power",
              "away": "mdi:snowflake",
              "comfort_minus_1": "mdi:thermometer-chevron-down",
              "comfort_minus_2": "mdi:thermometer-minus"
            }
          }
        }
      }
    },
    "sensor": {
      "last_boot": {
        "default": "mdi:restart"
      },
      "load": {
        "default": "mdi:chip"
      }
    },
    "binary_sensor": {
      "clock_in_sync": {
        "default": "mdi:clock-check-outline"
      }
    }
  }
}
